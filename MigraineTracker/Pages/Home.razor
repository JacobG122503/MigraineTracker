@page "/"
@implements IDisposable
@inject JournalStore Store
@inject IJSRuntime JS

<PageTitle>Migraine Tracker</PageTitle>

<div class="home">
    <header class="today">
        <div class="today-date">@_todayLabel</div>
        <div class="today-line @(TodayLine is null ? "empty" : "")">@(TodayLine ?? "Nothing logged today")</div>
    </header>

    <form class="entry" @onsubmit="Rate">
        <label class="entry-label" for="pain">Pain level</label>
        <input id="pain" class="entry-input @(_invalid ? "invalid" : "")" @bind="_value" @bind:event="oninput" @bind:after="() => _invalid = false"
               inputmode="decimal" enterkeyhint="done" autocomplete="off" placeholder="0" maxlength="4" />
        <div class="entry-hint @(_invalid ? "invalid" : "")">@(_invalid ? "Enter a number from 0.5 to 10" : "Enter a number from 0.5 to 10")</div>
        <button type="button" class="chip woke @(_woke ? "on" : "")" aria-pressed="@_woke" @onclick="() => _woke = !_woke">Woke with it</button>
        <button type="submit" class="entry-log" disabled="@string.IsNullOrWhiteSpace(_value)">Log</button>
    </form>

    <div class="extras">
        <button type="button" class="chip" @onclick='() => Med("Ibuprofen")'>Ibuprofen</button>
        <button type="button" class="chip" @onclick='() => Med("Tylenol")'>Tylenol</button>
        <button type="button" class="chip" @onclick="Emgality">Emgality</button>
        <button type="button" class="chip" @onclick="() => _noteOpen = !_noteOpen">Note</button>
    </div>

    @if (_noteOpen)
    {
        <form class="note-row" @onsubmit="AddNote">
            <input @bind="_note" placeholder="e.g. Drank last night" aria-label="Note for today" autofocus />
            <button type="submit" class="chip on">Add</button>
        </form>
    }

    @if (_toast is not null)
    {
        <div class="toast" role="status">
            <span>@_toast</span>
            @if (Store.CanUndo)
            {
                <button type="button" @onclick="Undo">Undo</button>
            }
        </div>
    }
</div>

@code {
    bool _woke, _invalid, _noteOpen;
    string _note = "", _value = "";
    string? _toast;
    string _todayLabel = "";
    DateOnly _today;
    CancellationTokenSource? _toastTimer;

    static readonly string[] Weekdays = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
    static readonly string[] Months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

    string? TodayLine
    {
        get
        {
            var top = Store.Journal.Days.FirstOrDefault();
            return top is not null && top.Date == _today && top.Content.Length > 0 ? top.Line.Trim() : null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnChanged;
        await RefreshToday();
    }

    async Task RefreshToday()
    {
        var now = await Store.NowAsync();
        _today = DateOnly.FromDateTime(now);
        _todayLabel = $"{Weekdays[(int)now.DayOfWeek]}, {Months[now.Month - 1]} {now.Day}";
    }

    async Task Rate()
    {
        var text = _value.Trim().Replace(',', '.');
        if (!double.TryParse(text, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v)
            || v <= 0 || v > 10)
        {
            _invalid = true;
            return;
        }
        v = Math.Round(v, 1);
        bool woke = _woke;
        await Store.ApplyAsync((t, now) => JournalEditor.AddRating(t, now, v, woke));
        _value = "";
        _woke = _invalid = false;
        await Done();
    }

    async Task Med(string name)
    {
        await Store.ApplyAsync((t, now) => JournalEditor.AddMed(t, now, name));
        await Done();
    }

    async Task Emgality()
    {
        await Store.ApplyAsync(JournalEditor.AddEmgality);
        var n = JournalParser.LastEmgalityNumber(Store.Journal);
        await Done($"Added (Emgality {n})");
    }

    async Task AddNote()
    {
        var note = _note;
        await Store.ApplyAsync((t, now) => JournalEditor.AddNote(t, now, note));
        _note = "";
        _noteOpen = false;
        await Done();
    }

    async Task Undo()
    {
        await Store.UndoAsync();
        _toast = "Undone";
        StartToastTimer();
    }

    async Task Done(string? message = null)
    {
        await RefreshToday();
        await JS.InvokeVoidAsync("mt.vibrate");
        _toast = message ?? $"Saved: {TodayLine}";
        StartToastTimer();
    }

    void StartToastTimer()
    {
        _toastTimer?.Cancel();
        var cts = _toastTimer = new CancellationTokenSource();
        _ = Task.Delay(5000, cts.Token).ContinueWith(t =>
        {
            if (t.IsCanceled) return;
            _toast = null;
            InvokeAsync(StateHasChanged);
        }, TaskScheduler.Default);
    }

    void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Store.Changed -= OnChanged;
        _toastTimer?.Cancel();
    }
}
