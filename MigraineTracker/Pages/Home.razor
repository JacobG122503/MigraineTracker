@page "/"
@implements IDisposable
@inject JournalStore Store
@inject IJSRuntime JS

<PageTitle>Migraine Tracker</PageTitle>

<div class="home">
    <header class="today">
        <div class="today-date">@_todayLabel</div>
        <div class="today-line @(TodayLine is null ? "empty" : "")">@(TodayLine ?? "Nothing logged today")</div>
    </header>

    <form class="entry" @onsubmit="Log">
        <label class="entry-label" for="pain">Pain level</label>
        <input id="pain" class="entry-input @(_invalid ? "invalid" : "")" @bind="_value" @bind:event="oninput" @bind:after="() => _invalid = false"
               inputmode="decimal" enterkeyhint="done" autocomplete="off" placeholder="0" maxlength="4" />
        <div class="entry-hint @(_invalid ? "invalid" : "")">@(_invalid ? "Enter a number from 0.5 to 10" : "Enter a number from 0.5 to 10")</div>
        <button type="button" class="chip woke @(_woke ? "on" : "")" aria-pressed="@_woke" @onclick="() => _woke = !_woke">Woke with it</button>
        <button type="submit" class="entry-log" disabled="@(!CanLog)">Log</button>
    </form>

    <div class="extras">
        @foreach (var med in Meds)
        {
            <button type="button" class="chip @(_meds.Contains(med) ? "on" : "")" aria-pressed="@_meds.Contains(med)" @onclick="() => ToggleMed(med)">@med</button>
        }
        <button type="button" class="chip @(_emgality ? "on" : "")" aria-pressed="@_emgality" @onclick="() => _emgality = !_emgality">Emgality</button>
        <button type="button" class="chip @(_noteOpen ? "on" : "")" aria-pressed="@_noteOpen" @onclick="() => _noteOpen = !_noteOpen">Note</button>
    </div>

    @if (_noteOpen)
    {
        <form class="note-row" @onsubmit="Log">
            <input @bind="_note" @bind:event="oninput" placeholder="e.g. Drank last night" aria-label="Note for today" autofocus />
        </form>
    }

    @if (_toast is not null)
    {
        <div class="toast" role="status">
            <span>@_toast</span>
            @if (Store.CanUndo)
            {
                <button type="button" @onclick="Undo">Undo</button>
            }
        </div>
    }
</div>

@code {
    static readonly string[] Meds = ["Ibuprofen", "Tylenol"];

    readonly HashSet<string> _meds = new();
    bool _woke, _invalid, _noteOpen, _emgality;
    string _note = "", _value = "";
    string? _toast;
    string _todayLabel = "";
    DateOnly _today;
    CancellationTokenSource? _toastTimer;

    static readonly string[] Weekdays = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
    static readonly string[] Months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

    string? TodayLine
    {
        get
        {
            var top = Store.Journal.Days.FirstOrDefault();
            return top is not null && top.Date == _today && top.Content.Length > 0 ? top.Line.Trim() : null;
        }
    }

    bool HasPain => !string.IsNullOrWhiteSpace(_value);
    bool HasNote => _noteOpen && !string.IsNullOrWhiteSpace(_note);
    bool CanLog => HasPain || HasNote || _emgality || _meds.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnChanged;
        await RefreshToday();
    }

    async Task RefreshToday()
    {
        var now = await Store.NowAsync();
        _today = DateOnly.FromDateTime(now);
        _todayLabel = $"{Weekdays[(int)now.DayOfWeek]}, {Months[now.Month - 1]} {now.Day}";
    }

    void ToggleMed(string med)
    {
        if (!_meds.Remove(med)) _meds.Add(med);
    }

    // Writes everything selected as one edit, so one Undo takes it all back.
    async Task Log()
    {
        if (!CanLog) return;

        double? pain = null;
        if (HasPain)
        {
            var text = _value.Trim().Replace(',', '.');
            if (!double.TryParse(text, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v)
                || v <= 0 || v > 10)
            {
                _invalid = true;
                return;
            }
            pain = Math.Round(v, 1);
        }

        bool woke = _woke, emgality = _emgality, onlyEmgality = emgality && pain is null && _meds.Count == 0 && !HasNote;
        var meds = Meds.Where(_meds.Contains).ToList();
        var note = HasNote ? _note : null;

        await Store.ApplyAsync((t, now) =>
        {
            if (pain is double p) t = JournalEditor.AddRating(t, now, p, woke);
            foreach (var med in meds) t = JournalEditor.AddMed(t, now, med);
            if (note is not null) t = JournalEditor.AddNote(t, now, note);
            if (emgality) t = JournalEditor.AddEmgality(t, now);
            return t;
        });

        _value = _note = "";
        _meds.Clear();
        _woke = _invalid = _noteOpen = _emgality = false;

        await RefreshToday();
        var shot = emgality ? $"Emgality {JournalParser.LastEmgalityNumber(Store.Journal)}" : null;
        await Done(onlyEmgality ? $"Added ({shot})" : shot is not null ? $"Saved: {TodayLine} ({shot})" : null);
    }

    async Task Undo()
    {
        await Store.UndoAsync();
        _toast = "Undone";
        StartToastTimer();
    }

    async Task Done(string? message = null)
    {
        await RefreshToday();
        await JS.InvokeVoidAsync("mt.vibrate");
        _toast = message ?? $"Saved: {TodayLine}";
        StartToastTimer();
    }

    void StartToastTimer()
    {
        _toastTimer?.Cancel();
        var cts = _toastTimer = new CancellationTokenSource();
        _ = Task.Delay(5000, cts.Token).ContinueWith(t =>
        {
            if (t.IsCanceled) return;
            _toast = null;
            InvokeAsync(StateHasChanged);
        }, TaskScheduler.Default);
    }

    void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Store.Changed -= OnChanged;
        _toastTimer?.Cancel();
    }
}
