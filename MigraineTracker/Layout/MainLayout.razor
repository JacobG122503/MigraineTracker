@inherits LayoutComponentBase
@implements IDisposable
@inject JournalStore Store

<div class="shell">
    <main class="screen">
        @if (_ready)
        {
            @Body
        }
    </main>

    <nav class="tabbar" aria-label="Main">
        <NavLink href="settings" class="tab">
            <span class="tab-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.7 3.5h4.6l.5 2.5 1.6.9 2.4-.8 2.3 4-1.9 1.7v1.8l1.9 1.7-2.3 4-2.4-.8-1.6.9-.5 2.5H9.7l-.5-2.5-1.6-.9-2.4.8-2.3-4 1.9-1.7v-1.8L2.9 10.1l2.3-4 2.4.8 1.6-.9.5-2.5Z" /><circle cx="12" cy="12" r="3" /></svg>
                <i class="sync-dot @Store.Sync.ToString().ToLowerInvariant()"></i>
            </span>
            <span>Settings</span>
        </NavLink>
        <NavLink href="notes" class="tab">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3.5" width="14" height="17" rx="2.5" /><path d="M8.5 8.5h7M8.5 12h7M8.5 15.5h4" /></svg>
            <span>Notes</span>
        </NavLink>
        <NavLink href="" Match="NavLinkMatch.All" class="tab">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 8v8M8 12h8" /></svg>
            <span>Log</span>
        </NavLink>
        <NavLink href="calendar" class="tab">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="2.5" /><path d="M3.5 9.5h17M8 3v4M16 3v4" /><path d="M7.5 13.5h2M11 13.5h2M14.5 13.5h2M7.5 16.5h2M11 16.5h2" /></svg>
            <span>Calendar</span>
        </NavLink>
        <NavLink href="graph" class="tab">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 20V12M10 20V6M15 20v-9M20 20V9" /></svg>
            <span>Graph</span>
        </NavLink>
    </nav>
</div>

@code {
    bool _ready;

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnChanged;
        await Store.InitializeAsync();
        _ready = true;
    }

    void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Store.Changed -= OnChanged;
}
